/* SPDX-License-Identifier: MIT */
&pinctrl {
	bridge_spis: bridge_spis {
		group1 {
			psels = <NRF_PSEL(SPIS_SCK, 0, 20)>, <NRF_PSEL(SPIS_MOSI, 0, 17)>,
			        <NRF_PSEL(SPIS_MISO, 0, 22)>, <NRF_PSEL(SPIS_CSN, 0, 24)>;
		};
	};
};
&spi2 {
	compatible = "nordic,nrf-spis";
	status = "okay";
	def-char = <0xff>;
	pinctrl-0 = <&bridge_spis>;
	pinctrl-names = "default";
};

/* Keep the original bootloader storage untouched. Carve NVS from our app area. */
&application { reg = <0x26000 0xc2000>; };
&{/soc/flash-controller@4001e000/flash@0/partitions} {
    hitbox_nvs: partition@e8000 { label = "hitbox-nvs"; reg = <0xe8000 0x4000>; };
};
